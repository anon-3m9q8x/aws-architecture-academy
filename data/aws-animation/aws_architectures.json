          "duration_ms": 1900,
          "packet_color": "#ffb347",
          "edge_color": "#ed922b"
        },
        {
          "order": 7,
          "source": "db",
          "target": "a",
          "title": "DB応答",
          "operation": "SQL",
          "duration_ms": 1900,
          "packet_color": "#ffb347",
          "edge_color": "#ed922b"
        },
        {
          "order": 8,
          "source": "a",
          "target": "alb",
          "title": "アプリケーション応答",
          "operation": "HTTP(S)",
          "duration_ms": 1900,
          "packet_color": "#ffb347",
          "edge_color": "#ed922b"
        },
        {
